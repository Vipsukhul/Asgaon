# ==============================================================================
# Asgaon — SPRING BOOT BACKEND ENVIRONMENT TEMPLATE
# (Copy this to backend/.env for local development or set in Render Environment Variables)
# ==============================================================================

# Server Port & Active Profile (use 'prod' for production deployment)
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/digitalgaon
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JPA & Hibernate
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Flyway Database Migration
FLYWAY_ENABLED=true

# Security & JWT Tokens (Must be at least 32 characters long)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Whitelist (Comma-separated origins, include your production Vercel URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Cloudinary Media Uploads (from Cloudinary Dashboard -> Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail / SMTP Email Notifications (for Citizen Verification & OTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-google-app-password

# Web Push Notifications (Optional VAPID Keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@asgaon.digitalgaon.in

