# ==============================================================================
# Asgaon — CIVIC PORTAL (FRONTEND ENVIRONMENT TEMPLATE)
# ==============================================================================

# API Base URL for backend Spring Boot services
# For local development: /api/v1 (proxied by Vite)
# For production Vercel deployment: https://your-backend.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Village & Civic Jurisdiction Metadata
VITE_APP_NAME="Asgaon - Village Civic Portal"
VITE_VILLAGE_NAME="Asgaon"
VITE_TALUKA="Pauni"
VITE_DISTRICT="Bhandara"
VITE_STATE="Maharashtra"
VITE_PINCODE="441910"

# Civic Emergency Helplines
VITE_HELPLINE_EMERGENCY="112"
VITE_HELPLINE_AMBULANCE="108"
VITE_HELPLINE_KISAN="1800-180-1551"
VITE_HELPLINE_WATER="9822081100"

# Application Feature Flags & Localization
VITE_DEFAULT_LANG="EN"
VITE_SUPPORTED_LANGS="EN,MR"
VITE_ENABLE_ANALYTICS=false

# Google OAuth2 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Government Open Data API (data.gov.in & eGramSwaraj)
VITE_DATA_GOV_API_KEY=your_datagov_in_api_key_here
VITE_ASGAON_LGD_CODE="537407"

# Google Gemini AI API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

